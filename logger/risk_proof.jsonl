{"received_at": "2026-11-26T14:30:12.485214+00:00", "event": {"ts": "2026-11-26T14:30:12.483844+00:00", "event": "post_tool_call", "tool": "read_file", "args": {"path": "/opt/data/plugins/inspector/__init__.py"}, "result": "{\"content\": \"1|\\\"\\\"\\\"Inspector plugin: records tool calls, LLM turns and provider requests.\\r\\n2|\\r\\n3|Events are sent to an external JSONL logging server, authenticated with a\\r\\n4|shared bearer secret (INSPECTOR_SECRET).\\r\\n5|\\r\\n6|All hooks are observers: they never block, modify or inject anything.\\r\\n7|\\r\\n8|SECURITY NOTE: this plugin runs inside the agent's process, so everything it\\r\\n9|reports is the agent's own claim, and the agent can read INSPECTOR_SECRET.\\r\\n10|The secret only keeps *other* network peers from posting events. Do not treat\\r\\n11|this log as tamper-proof evidence; cross-check it against an outside observer.\\r\\n12|\\\"\\\"\\\"\\r\\n13|\\r\\n14|import json\\r\\n15|import logging\\r\\n16|import os\\r\\n17|import re\\r\\n18|import urllib.error\\r\\n19|import urllib.request\\r\\n20|from datetime import datetime, timezone\\r\\n21|\\r\\n22|logger = logging.getLogger(\\\"inspector\\\")\\r\\n23|\\r\\n24|LOGGER_URL = os.environ.get(\\\"INSPECTOR_LOGGER_URL\\\")\\r\\n25|INSPECTOR_SECRET = os.environ.get(\\\"INSPECTOR_KEY\\\", \\\"\\\")\\r\\n26|MAX_FIELD = int(os.environ.get(\\\"INSPECTOR_MAX_FIELD\\\", \\\"4000\\\"))\\r\\n27|\\r\\n28|# Only send events when both the URL and the secret are configured.\\r\\n29|ENABLED = bool(LOGGER_URL and INSPECTOR_SECRET)\\r\\n30|\\r\\n31|# Crude secret masking; extend it for your own key formats.\\r\\n32|_SECRET = re.compile(r\\\"(sk-[A-Za-z0-9_\\\\-]{16,}|Bearer\\\\s+[A-Za-z0-9._\\\\-]{16,})\\\")\\r\\n33|\\r\\n34|CAPTURE_REASONING = False\\r\\n35|CAPTURE_TEXT_DELTA_STREAM = False\\r\\n36|\\r\\n37|# Failure reporting state: log the first failure, then every Nth, to avoid\\r\\n38|# flooding logs when the server is down, rejecting us, or its log is full.\\r\\n39|_FAILURE_LOG_EVERY = 100\\r\\n40|_failure_count = 0\\r\\n41|\\r\\n42|\\r\\n43|def _redact(text: str) -> str:\\r\\n44|    text = _SECRET.sub(\\\"[REDACTED]\\\", text)\\r\\n45|    # Also strip the inspector secret itself, in case the agent echoes its\\r\\n46|    # environment or config into a tool result.\\r\\n47|    if INSPECTOR_SECRET:\\r\\n48|        text = text.replace(INSPECTOR_SECRET, \\\"[REDACTED]\\\")\\r\\n49|    return text\\r\\n50|\\r\\n51|\\r\\n52|def _clean(obj, depth=0):\\r\\n53|    \\\"\\\"\\\"Make any payload JSON-safe, redacted and size-limited.\\\"\\\"\\\"\\r\\n54|    if depth > 6:\\r\\n55|        return \\\"<max depth>\\\"\\r\\n56|\\r\\n57|    if isinstance(obj, str):\\r\\n58|        text = _redact(obj)\\r\\n59|        if len(text) > MAX_FIELD:\\r\\n60|            text = text[:MAX_FIELD] + f\\\"...[+{len(text) - MAX_FIELD} chars]\\\"\\r\\n61|        return text\\r\\n62|\\r\\n63|    if isinstance(obj, dict):\\r\\n64|        return {str(k): _clean(v, depth + 1) for k, v in obj.items()}\\r\\n65|\\r\\n66|    if isinstance(obj, (list, tuple)):\\r\\n67|        return [_clean(v, depth + 1) for v in obj[:50]]\\r\\n68|\\r\\n69|    if isinstance(obj, (int, float, bool)) or obj is None:\\r\\n70|        return obj\\r\\n71|\\r\\n72|    return _clean(str(obj), depth + 1)\\r\\n73|\\r\\n74|\\r\\n75|def _report_failure(event: str, reason: str) -> None:\\r\\n76|    global _failure_count\\r\\n77|    _failure_count += 1\\r\\n78|    if _failure_count == 1 or _failure_count % _FAILURE_LOG_EVERY == 0:\\r\\n79|        logger.warning(\\r\\n80|            \\\"inspector failed to send event %s (%s); %d failure(s) so far\\\",\\r\\n81|            event, reason, _failure_count,\\r\\n82|        )\\r\\n83|\\r\\n84|\\r\\n85|def _write(event: str, **fields):\\r\\n86|    \\\"\\\"\\\"Send one JSON event to the external logger. Never raises.\\\"\\\"\\\"\\r\\n87|    if not ENABLED:\\r\\n88|        return\\r\\n89|\\r\\n90|    try:\\r\\n91|        record = {\\r\\n92|            \\\"ts\\\": date